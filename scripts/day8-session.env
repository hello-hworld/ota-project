# [ota-host] ~/ota-project/scripts/day8-session.env — DAY8 터미널마다 source 한다 (인증정보 없음)
# day7-session.env(KUBECONFIG·context·PATH·cd·DAY7 함수·G/C digest)를 그대로 쓰고, 증거 위치와 DAY8 값만 더한다.
# mark·ev_commit·cstats·npods 등 DAY7 함수와 demo-check.py·http-watch.sh는 이 EV를 기준으로 동작한다.
# shellcheck shell=bash
# shellcheck source=/dev/null
source "$HOME/ota-project/scripts/day7-session.env"

export EV="$REPO/docs/evidence/day8"
export PROD_IMG=C                 # 업그레이드 종료 시 Production 이미지 (demo-check.py 기대값). 다르면 G로 바꾼다
export MON_NS=monitoring
export PROM_CHART="$REPO/helm/monitoring/chart/prometheus-29.37.0.tgz"
export GRAFANA_CHART="$REPO/helm/monitoring/chart/grafana-13.6.0.tgz"
export PROM_A_URL="http://127.0.0.1:19090"      # (선택) A Prometheus Target 화면 port-forward 주소 (확인 뒤 끈다)
export PROM_B_URL="http://192.168.56.32:30909"  # B Prometheus NodePort (worker-b2, externalTrafficPolicy Local)
export GRAFANA_URL="http://127.0.0.1:13000"     # T2의 Grafana port-forward
mkdir -p "$EV"

# VM SSH 명령 하나 (upg-lib.sh의 nssh와 달리 IP 끝자리만 받는다). 사용: vssh <20|21|30|31|32> '<명령>'
vssh() {
  ssh -n -i "$HOME/.ssh/ota_lab" -o BatchMode=yes -o ConnectTimeout=5 "devops@192.168.56.$1" "$2"
}

# monitoring Namespace의 Pod 상태 한 줄씩: 이름·Node·phase·Ready·재시작·이전 종료 사유. 사용: monpods <context>
monpods() {
  kubectl --context "$1" -n "$MON_NS" get pods -o jsonpath='{range .items[*]}{.metadata.name}{" node="}{.spec.nodeName}{" phase="}{.status.phase}{" ready="}{.status.containerStatuses[*].ready}{" restarts="}{.status.containerStatuses[*].restartCount}{" last="}{.status.containerStatuses[*].lastState.terminated.reason}{"\n"}{end}'
}

# 측정 전 확인: port-forward·연속 수집이 꺼져 있는지 (P0·P1·P2를 같은 조건으로)
quiet_check() {
  local pf sm
  pf="$(pgrep -af 'kubectl.*port-forward' || true)"
  sm="$(pgrep -af 'scripts/sample(-guests)?\.sh' || true)"
  echo "port-forward: ${pf:-없음}"
  echo "연속 수집: ${sm:-없음}"
  [[ -z "$pf" && -z "$sm" ]] || { echo "STOP: 측정 조건이 다르다 → T2·T3·T4·T6을 끄고 다시"; return 1; }
}

# monitoring 설치 확인 한 묶음: Pod·이미지·PVC와 PV의 Node·Service·Node Pressure·비정상 Pod. 사용: mon_state <context>
mon_state() {
  local c="$1" pv
  echo "## $c monitoring pods"; monpods "$c"
  echo "## $c images (실제 imageID)"
  kubectl --context "$c" -n "$MON_NS" get pods -o jsonpath='{range .items[*]}{range .status.containerStatuses[*]}{.image}{" "}{.imageID}{"\n"}{end}{end}' | sort -u
  echo "## $c pvc → pv node·경로·reclaim"
  kubectl --context "$c" -n "$MON_NS" get pvc
  for pv in $(kubectl --context "$c" -n "$MON_NS" get pvc -o jsonpath='{.items[*].spec.volumeName}'); do
    echo "$pv node=$(kubectl --context "$c" get pv "$pv" -o jsonpath='{.spec.nodeAffinity.required.nodeSelectorTerms[0].matchExpressions[0].values[0]} path={.spec.hostPath.path}{.spec.local.path} reclaim={.spec.persistentVolumeReclaimPolicy}')"
  done
  echo "## $c services"; kubectl --context "$c" -n "$MON_NS" get svc
  echo "## $c node 상태"
  kubectl --context "$c" get nodes -o custom-columns='NODE:.metadata.name,READY:.status.conditions[?(@.type=="Ready")].status,MEM:.status.conditions[?(@.type=="MemoryPressure")].status,DISK:.status.conditions[?(@.type=="DiskPressure")].status,PID:.status.conditions[?(@.type=="PIDPressure")].status'
  echo "## $c Running·Completed가 아닌 Pod"
  kubectl --context "$c" get pods -A --no-headers | grep -v -E ' (Running|Completed) ' || echo "(없음)"
}
