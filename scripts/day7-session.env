# [ota-host] ~/ota-project/scripts/day7-session.env — DAY7 터미널마다 source 한다 (인증정보 없음)
# day6-session.env(KUBECONFIG·context·PATH·cd)를 그대로 쓰고 DAY7 값과 작은 함수만 더한다.
# shellcheck shell=bash
# shellcheck source=/dev/null
source "$HOME/ota-project/scripts/day6-session.env"

export REPO="$HOME/ota-project"
export EV="$REPO/docs/evidence/day7"
export ARGOCD_CHART="$REPO/helm/argocd/chart/argo-cd-10.10.3.tgz"
export REPO_URL="https://github.com/hello-hworld/ota-project.git"
export OTA_B_SERVER="https://192.168.56.30:6443"
export IMG_REPO="192.168.56.21:32000/day6/demo"
# DAY6 성공 이미지 (docs/evidence/day6/14-run01, 14-run02의 build-info.txt)
export G_DIGEST="sha256:2db15224ca3bc50e20cc3869a91978235d6a4f1a25d613260d0bc15d29ea0478"
export G_VERSION="2f99fb73f694-day6-ci-2"
export C_DIGEST="sha256:6068b90a242e7d40415786a9b7498f81a8b3f9324f4944d163a699df231e7b8e"
export C_VERSION="50615d6ab9d2-day6-ci-3"
mkdir -p "$EV"

# 구간 기록: 측정 파일의 피크를 어느 작업이 만들었는지 맞춰 보기 위한 UTC 시각표
mark() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$EV/00-timeline.txt"; }

# values 한 줄만 바꾼다. 사용: setv <staging|production> <digest|replicas|readiness> <값>
setv() {
  local f="$REPO/values/$1.yaml" k="$2" v="$3"
  [[ -f "$f" ]] || { echo "STOP: $f 없음"; return 1; }
  case "$k" in
    digest)    [[ "$v" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "STOP: digest 형식 오류: $v"; return 1; }
               sed -i -E "s|^(  digest: ).*$|\1$v|" "$f" ;;
    replicas)  [[ "$v" =~ ^[0-9]+$ ]] || { echo "STOP: replicas는 숫자"; return 1; }
               sed -i -E "s|^replicaCount: .*$|replicaCount: $v|" "$f" ;;
    readiness) [[ "$v" =~ ^/[A-Za-z0-9/_-]*$ ]] || { echo "STOP: 경로 형식 오류: $v"; return 1; }
               sed -i -E "s|^(    path: ).*$|\1$v|" "$f" ;;
    *) echo "STOP: 알 수 없는 키 $k"; return 1 ;;
  esac
  git -C "$REPO" --no-pager diff -- "$f"
}

# 렌더링 결과에서 바뀌는 값만 보여 준다. 렌더링 실패면 0이 아닌 종료 코드
render_check() {
  helm template "ota-demo-$1" "$REPO/charts/demo" -n "$1" -f "$REPO/values/$1.yaml" \
    | grep -E '^ +(replicas|image|path):'
}

# 지정한 파일만 Commit·Push 한다. 이미 stage된 다른 변경이 있으면 멈춘다(되돌릴 Commit을 깨끗하게 유지)
gitops_commit() {
  local msg="$1"; shift
  git -C "$REPO" diff --cached --quiet || { echo "STOP: 이미 stage된 변경이 있다"; return 1; }
  git -C "$REPO" add -- "$@" || return 1
  git -C "$REPO" diff --cached --quiet && { echo "STOP: 바뀐 내용이 없다"; return 1; }
  git -C "$REPO" --no-pager diff --cached --stat
  git -C "$REPO" commit -q -m "$msg" || { git -C "$REPO" reset -q -- "$@"; echo "STOP: commit 실패 (stage 해제함)"; return 1; }
  git -C "$REPO" push -q origin HEAD:main \
    || { echo "STOP: push 실패. 로컬 Commit은 있다 → 원인 확인 후 git push origin HEAD:main"; return 1; }
  mark "commit $(git -C "$REPO" rev-parse --short HEAD) $msg"
}

# 지정한 Commit 하나를 되돌리는 Commit을 만들고 Push 한다
gitops_revert() {
  local sha="$1"
  git -C "$REPO" diff --cached --quiet || { echo "STOP: 이미 stage된 변경이 있다"; return 1; }
  git -C "$REPO" revert --no-edit "$sha" || return 1
  git -C "$REPO" push -q origin HEAD:main || { echo "STOP: push 실패"; return 1; }
  mark "revert $(git -C "$REPO" rev-parse --short HEAD) (reverts ${sha:0:12})"
}

# 증거·보고서 파일만 Commit·Push 한다. 사용: ev_commit "메시지"
ev_commit() {
  local d
  git -C "$REPO" diff --cached --quiet || { echo "STOP: 이미 stage된 변경이 있다"; return 1; }
  for d in docs/evidence docs/baseline; do
    [[ -e "$REPO/$d" ]] && git -C "$REPO" add -- "$d"
  done
  git -C "$REPO" diff --cached --quiet && { echo "(증거 변경 없음)"; return 0; }
  git -C "$REPO" commit -q -m "$1" || { echo "STOP: commit 실패"; return 1; }
  git -C "$REPO" push -q origin HEAD:main || { echo "STOP: push 실패"; return 1; }
  echo "증거 commit $(git -C "$REPO" rev-parse --short HEAD) $1"
}

# 노드의 컨테이너별 CPU·메모리 (metrics-server 대신). 사용: cstats <IP 끝자리 21|31|32>
cstats() {
  ssh -n -i "$HOME/.ssh/ota_lab" -o BatchMode=yes -o ConnectTimeout=5 "devops@192.168.56.$1" \
    'sudo crictl --runtime-endpoint unix:///run/containerd/containerd.sock stats 2>&1' \
    | sed 's/\x1b\[[0-9;]*[A-Za-z]//g'
}

# 실행 중이거나 종료 중인 Pod 수. 사용: npods <context> <namespace>
npods() { kubectl --context "$1" -n "$2" get pods -o name 2>/dev/null | wc -l; }
