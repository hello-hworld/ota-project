export OTA_CTX_A=ota-a
export OTA_CTX_B=ota-b
export PATH="$HOME/.local/bin:$PATH"
cd "$HOME/ota-project"
export DAY6_CHART_PACKAGE="$HOME/ota-project/helm/jenkins/chart/jenkins-5.9.68.tgz"
