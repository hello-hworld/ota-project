# [ota-host] ~/ota-project/scripts/upg-session.env — K8s 업그레이드 터미널마다 source 한다 (인증정보 없음)
# day7-session.env(KUBECONFIG·context·PATH·DAY7 함수·G/C digest)를 그대로 쓰고, 증거 위치와 업그레이드 값만 더한다.
# mark·ev_commit·gitops_commit 등 DAY7 함수는 이 EV를 기준으로 동작한다.
# shellcheck shell=bash
# shellcheck source=/dev/null
source "$HOME/ota-project/scripts/day7-session.env"

export EV="$REPO/docs/evidence/k8s-upgrade"
export UPG_FROM=1.30.14
export UPG_TO=1.36.5
export PROD_IMG=C        # DAY7 종료 시 Production 이미지. 다르면 G로 바꾼다 (demo-check.py 기대값)
mkdir -p "$EV"
