# ota-host Bash, every terminal. Use one run id across terminals.
[[ -f "$HOME/ota-project/scripts/day8-session.env" ]] || { echo 'STOP: DAY8 session file missing'; return 1; }
source "$HOME/ota-project/scripts/day8-session.env" || return 1
export PYTHONDONTWRITEBYTECODE=1
export DAY9_RUN="${DAY9_RUN:-run01}"
[[ "$DAY9_RUN" =~ ^[A-Za-z0-9_-]+$ ]] || { echo 'Invalid DAY9_RUN'; return 1; }
export EV="$REPO/docs/evidence/day9/$DAY9_RUN"
mkdir -p "$EV"
set -o pipefail
day9log() {
 local label="$1"; shift
 [[ "$label" =~ ^[A-Za-z0-9_-]+$ && "$#" -gt 0 ]] || { echo 'STOP: invalid log label/command'; return 1; }
 local file="$EV/$(date -u +%Y%m%dT%H%M%S%NZ)-$label.txt"
 local codes=()
 if "$@" 2>&1 | tee "$file"; then
   codes=("${PIPESTATUS[@]}")
 else
   codes=("${PIPESTATUS[@]}")
 fi
 printf 'command_exit=%s log_exit=%s\n' "${codes[0]}" "${codes[1]}" | tee -a "$file"
 [[ "${codes[0]}" == 0 && "${codes[1]}" == 0 ]]
}
